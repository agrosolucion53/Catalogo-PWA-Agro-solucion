{
  "name": "alimento-del-cielo-pwa",
  "version": "1.0.0",
  "description": "PWA de catálogo agropecuario con integración Wompi",
  "main": "index.html",
  "scripts": {
    "dev": "netlify dev",
    "build": "echo 'No build needed for static site'",
    "deploy": "netlify deploy --prod",
    "update:productos": "node actualizar-version-productos.js patch",
    "update:productos:minor": "node actualizar-version-productos.js minor",
    "update:productos:major": "node actualizar-version-productos.js major",
    "version:bump": "npm version patch && node actualizar-version-productos.js patch",
    "inventario:listar": "node inventario-manager.js listar",
    "inventario:reporte": "node inventario-manager.js reporte"
  },
  "keywords": [
    "pwa",
    "alimentos",
    "agropecuaria",
    "agro",
    "wompi",
    "ecommerce"
  ],
  "author": "AGRO SOLUCION",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.12.2",
    "firebase-admin": "^11.11.1",
    "node-fetch": "^2.6.7"
  },
  "devDependencies": {
    "netlify-cli": "^17.0.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
